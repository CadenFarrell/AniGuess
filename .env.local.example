# Copy this file to .env.local and fill in your Firebase project's web app
# config (console.firebase.google.com → Project settings → Your apps → Web app)
# to enable "Play Online" multiplayer. Without this file, the app runs in
# local pass-and-play mode only — no Firebase dependency at all.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point at a local Firebase emulator suite instead of a real
# project: `firebase emulators:start --only database,auth --project demo-aniguess`
# (firebase.json has singleProjectMode enabled, so the auth + database
# emulators share one namespace). When true, VITE_FIREBASE_DATABASE_URL must
# use the "-default-rtdb" suffixed namespace singleProjectMode actually uses —
# NOT just your --project value — e.g.:
# http://127.0.0.1:9000/?ns=demo-aniguess-default-rtdb
# Using the wrong namespace here silently connects to an unconfigured (rules-
# less) database instead of the one your database.rules.json was deployed to.
VITE_USE_FIREBASE_EMULATOR=false
