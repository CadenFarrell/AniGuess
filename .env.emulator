# Config for running against the local Firebase emulator, so online features can
# be exercised without touching a real project:
#
#   npx firebase emulators:start --only database,auth --project demo-aniguess
#   npm run dev -- --mode emulator --port 5175
#
# The port matters as much as the config: a different port is a different
# origin, so emulator runs get their own localStorage and cannot disturb the
# profiles saved against the normal dev server.
#
# These values are deliberately fake — the emulator accepts any project it is
# started with, and connectDatabaseEmulator() in firebase.js overrides the host.
# The one part that must be exact is the DATABASE_URL namespace: it has to carry
# the -default-rtdb suffix, or the client talks to a rules-less namespace and
# every rule you meant to test silently passes.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-aniguess.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://demo-aniguess-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=demo-aniguess
VITE_FIREBASE_STORAGE_BUCKET=demo-aniguess.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_FIREBASE_EMULATOR=true
